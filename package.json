{
  "name": "hajara-medicals",
  "productName": "Hajara Medicals",
  "private": true,
  "version": "1.0.0",
  "description": "Hajara Medicals — Billing & Inventory desktop app",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,magenta \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "build:web": "vite build",
    "package": "node scripts/make-package.cjs",
    "installer": "node scripts/make-installer.cjs",
    "build": "npm run build:web && npm run package && npm run installer",
    "release": "npm run build && node scripts/make-release.cjs",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "electron-updater": "^6.8.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.1"
  }
}
